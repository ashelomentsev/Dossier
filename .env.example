# Secrets for the Edge Function. Set them with:
#   supabase secrets set --env-file ./.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected at runtime —
#  do not set them here.)

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Random string; also passed to setWebhook as `secret_token`. Telegram echoes it
# back in the X-Telegram-Bot-Api-Secret-Token header so we can authenticate calls.
TELEGRAM_WEBHOOK_SECRET=

# OpenAI key (Whisper, embeddings, label extraction, dossier summaries)
OPENAI_KEY=
